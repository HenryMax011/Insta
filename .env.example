# ---------- Servidor ----------
NODE_ENV=development
PORT=3000
# URL pública do servidor (em dev, use a URL do ngrok para receber webhooks)
PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# Número de proxies reversos à frente da app (Nginx, Cloudflare, ngrok...). 0 = nenhum
TRUST_PROXY=1

# ---------- Banco de dados ----------
DATABASE_URL=postgres://smm:smm_dev_password@localhost:5432/smm

# ---------- Gateway de pagamento ----------
# mercadopago | mock  (mock gera um PIX falso para testes locais)
PAYMENT_PROVIDER=mock
# Aplicação "Checkout Transparente" com API de Orders. Access Token em Suas integrações > Credenciais
MP_ACCESS_TOKEN=
# Suas integrações > Webhooks: URL {PUBLIC_URL}/api/webhooks/payment, evento "Order (Mercado Pago)".
# Cole aqui a "Assinatura secreta" gerada ao salvar.
MP_WEBHOOK_SECRET=
# Com Mercado Pago o mínimo efetivo é 30 minutos
PIX_EXPIRATION_MINUTES=30

# ---------- Tarefas periódicas na Vercel ----------
# Obrigatório na Vercel (mín. 32 caracteres). Um serviço de cron (ex.: cron-job.org) deve chamar
# GET {PUBLIC_URL}/api/cron/tick a cada minuto com o header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# ---------- Fornecedor SMM (API v2 padrão) ----------
SMM_API_URL=https://smmhub.com.br/api/v2
# Chave em https://smmhub.com.br/account
SMM_API_KEY=
# true = não chama o fornecedor real (retorna IDs falsos)
SMM_MOCK=true
# true = simula falha do fornecedor (ex.: sem saldo) para testar "Erro na Automação"
SMM_MOCK_FAIL=false
# Conversão da moeda da conta no fornecedor para BRL (1 se a conta já estiver em reais; ex.: 5.40 se for USD)
SMM_FX_TO_BRL=1

# ---------- Administração ----------
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=troque-por-um-token-aleatorio-de-no-minimo-32-caracteres

JOB_INTERVAL_SECONDS=60

# ---------- Alertas (saldo baixo e pedidos com erro) ----------
# Avisa quando o saldo no fornecedor (em R$) ficar abaixo deste valor
LOW_BALANCE_THRESHOLD=50
BALANCE_CHECK_MINUTES=10
# Telegram: crie um bot com o @BotFather e pegue o chat_id enviando /start para o @userinfobot
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
# WhatsApp via CallMeBot (grátis): siga https://www.callmebot.com/blog/free-api-whatsapp-messages/
# Telefone com DDI, só números (ex.: 5511999999999)
ALERT_WHATSAPP_PHONE=
ALERT_WHATSAPP_APIKEY=
